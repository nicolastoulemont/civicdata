      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${traces}"
          },
          "queryType": "traceql",
          "query": "{ span.gen_ai.operation.name = \"invoke_agent\" && resource.deployment.environment.name = \"$stage\" && span.civicdata.answer.ending = \"exhausted\" } | count_over_time()",
          "limit": 50,
          "metricsQueryType": "range"
