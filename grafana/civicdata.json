          "queryType": "traceql",
          "query": "{ span.gen_ai.operation.name = \"execute_tool\" && resource.deployment.environment.name = \"$stage\" && span.civicdata.tool.rejection != nil } | count_over_time()",
          "limit": 50,
          "metricsQueryType": "range"
