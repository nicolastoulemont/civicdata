          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${traces}"
          },
          "queryType": "traceql",
          "query": "{ name = \"LanguageModel.generateText\" && resource.deployment.environment.name = \"$stage\" } | sum_over_time(span.gen_ai.usage.input_tokens)",
          "limit": 50,
          "metricsQueryType": "range"
