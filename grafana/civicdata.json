{
  "uid": "civicdata",
  "title": "civicdata",
  "description": "The agent's answers, the app's requests and the sources behind them, from Tempo traces (docs/traces.md).",
  "tags": ["civicdata"],
  "editable": true,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "traces",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0
      },
      {
        "name": "stage",
        "label": "Stage",
        "type": "query",
        "datasource": {
          "type": "tempo",
          "uid": "${traces}"
        },
        "query": {
          "type": 1,
          "label": "resource.deployment.environment.name",
          "refId": "TempoDatasourceVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Questions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Questions",
      "description": "Answers the agent ran.",
      "datasource": {
        "type": "tempo",
        "uid": "${traces}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${traces}"
          },
          "queryType": "traceql",
          "query": "{ span.gen_ai.operation.name = \"invoke_agent\" && resource.deployment.environment.name = \"$stage\" } | count_over_time()",
          "limit": 50,
          "metricsQueryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Answered",
      "description": "",
      "datasource": {
        "type": "tempo",
        "uid": "${traces}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${traces}"
          },
          "queryType": "traceql",
          "query": "{ span.gen_ai.operation.name = \"invoke_agent\" && resource.deployment.environment.name = \"$stage\" && span.civicdata.answer.ending = \"answered\" } | count_over_time()",
          "limit": 50,
          "metricsQueryType": "range"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["sum"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Out of rounds",
      "description": "Answers still calling tools after 18 rounds.",
