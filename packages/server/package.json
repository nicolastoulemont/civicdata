{
  "name": "@civicdata/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./workflow": {
      "workerd": "./src/CatalogWorkflow.ts",
      "default": "./src/workflow.node.ts"
    }
  },
  "scripts": {
    "typecheck": "effect-tsgo tsc --noEmit && effect-tsgo tsc --noEmit -p scripts",
    "test": "vitest run",
    "titles": "node scripts/titles.ts",
    "eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@civicdata/domain": "workspace:*",
    "@effect/ai-openai": "4.1.2",
    "@effect/sql-d1": "4.1.2",
    "effect": "catalog:",
    "entities": "7.0.1",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@effect/vitest": "catalog:",
    "@types/node": "^24.19.2",
    "vitest": "catalog:"
  }
}
