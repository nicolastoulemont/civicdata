{
  "name": "@repo/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./workflow": {
      "workerd": "./src/workflows.ts",
      "default": "./src/workflow.node.ts"
    }
  },
  "scripts": {
    "typecheck": "effect-tsgo tsc --noEmit && effect-tsgo tsc --noEmit -p scripts",
    "test": "vitest run && vitest run --config vitest.scripts.config.ts",
    "titles": "node scripts/titles.ts",
    "triage": "node scripts/triage.ts",
    "outlines": "node scripts/outlines.ts",
    "eval": "vitest run --config vitest.eval.config.ts agent",
    "probe": "vitest run --config vitest.eval.config.ts probe",
    "ilostat": "node scripts/ilostat.ts",
    "faostat": "node scripts/faostat.ts",
    "vdem": "node scripts/vdem.ts",
    "wid": "node scripts/wid.ts",
    "imf": "node scripts/imf.ts",
    "papers": "node scripts/papers.ts",
    "research": "node scripts/research.ts",
    "papers:intake": "node scripts/intake.ts",
    "papers:publish": "node scripts/publish.ts"
  },
  "dependencies": {
    "@effect/ai-openai": "4.1.2",
    "@effect/sql-d1": "4.1.2",
    "@repo/domain": "workspace:*",
    "@repo/machine": "workspace:*",
    "aws4fetch": "1.0.20",
    "effect": "catalog:",
    "entities": "7.0.1",
    "fflate": "0.8.3",
    "stemmer": "2.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@effect/platform-node": "4.1.2",
    "@effect/vitest": "catalog:",
    "@types/node": "^24.19.2",
    "linkedom": "0.18.15",
    "unpdf": "2.1.0",
    "vitest": "catalog:"
  }
}
