# Settings `pnpm dev` reads. Copy this file to .env (gitignored) and fill it in.
# A variable exported in your shell overrides this file. CI deploys read the
# same names from the GitHub environment secrets instead.
#
# The OpenAI key does not go here. Store it in the macOS Keychain, where
# `pnpm dev`, local deploys (through with-key.sh) and the eval read it, in
# every worktree:
#
#   security add-generic-password -s civicdata-dev -a OPENAI_API_KEY -w
#
# Paste the key at both prompts. Without a key the app runs and every question
# answers "The assistant is not available".

# Optional. Empty uses the default model in packages/server/src/Agent.ts.
OPENAI_MODEL=

# Optional. Where a stage you deploy from this machine sends its spans
# (docs/traces.md). Empty records none. `pnpm dev` ignores it and sends its
# spans to the Grafana it starts.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional. Headers the endpoint needs, as `Name=value`, with the value
# URI-encoded; Grafana Cloud's OTLP page prints them in this form.
OTEL_EXPORTER_OTLP_HEADERS=
