{
  "$schema": "./node_modules/fallow/schema.json",
  // Vendored code follows its upstream; see each folder's UPSTREAM.md.
  "ignorePatterns": ["tools/oxlint/anti-slop/**", ".claude/**", ".agents/**"],
  // Vitest loads a custom environment by the path in its config, which
  // Fallow's Vitest plugin does not follow.
  "supportEntry": ["apps/web/test/environment.ts"],
  "ignoreDependencies": [
    // The tsconfig plugin name. @effect/tsgo provides it.
    "@effect/language-service",
    // Data files the web and map generators read by path, not by import.
    "flag-icons",
    "i18n-iso-countries",
    "world-atlas"
  ],
  // The workspace packages are private, so an export nothing in the repo uses
  // is dead even when it sits in a package entry point.
  "includeEntryExports": true,
  "ignoreExports": [
    // Alchemy loads the archive stack through its deploy command argument.
    { "file": "packages/infra/evals.run.ts", "exports": ["default"] },
    { "file": "packages/infra/maps.run.ts", "exports": ["default"] },
    // Vitest reads the web tests' environment through its config path.
    { "file": "apps/web/test/environment.ts", "exports": ["default"] },
    // TanStack Router generates this file and decides what it exports.
    { "file": "apps/web/src/routeTree.gen.ts", "exports": ["*"] },
    // shadcn components export every sub-part; pages use a few. An unused
    // component file is still reported.
    { "file": "apps/web/src/components/ui/**", "exports": ["*"] },
    // The Worker's entry: Cloudflare reads its default export and its Durable
    // Object classes.
    { "file": "apps/web/src/server.ts", "exports": ["*"] },
    // The Workflow classes the Worker entry exports. They reach the entry
    // through the `workerd` condition of @repo/server/workflow, which
    // Fallow does not resolve.
    {
      "file": "packages/server/src/workflows/workerd.ts",
      "exports": ["AnnotateWorkflow", "CatalogWorkflow", "GatherWorkflow", "PaperGatherWorkflow"]
    }
  ],
  // Cloudflare calls a Durable Object's handlers.
  "usedClassMembers": [{ "implements": "DurableObject", "members": ["fetch", "alarm"] }],
  "effect": { "schemaExportsAsTypes": true },
  // Two maps can project the same place at the same size, e.g. the Hawaii
  // inset on North America and the Americas, so generated outlines repeat.
  "duplicates": { "ignore": ["packages/maps/src/data/**"] },
  // shadcn's generated components are kept close to upstream rather than
  // restructured; complexity limits apply to our own code. Build scripts
  // (apps/web/scripts, packages/maps/scripts, tools/brand) run by hand; tests check what they write
  // (faces.gen.ts), not the scripts.
  "health": {
    "ignore": [
      "apps/web/src/components/ui/**",
      "apps/web/scripts/**",
      "packages/maps/scripts/**",
      "tools/brand/**"
    ]
  },
  "rules": {
    "unused-effect-layers": "error",
    "unused-tagged-errors": "error",
    "unproduced-catch-tags": "error"
  },
  // Dependencies point one way: web -> server -> domain. The machine package
  // depends on nothing of ours, so web and server both build on it. Maps
  // depend on domain, and web consumes their compiled public API. Infra
  // deploys the app and nothing imports it. A new package needs a zone before
  // CI passes.
  // Inside the server, platform and utils form the foundation, which every
  // zone may import and which imports no domain. Each domain imports only the
  // foundation and the domains before it in the order its zones are listed
  // (AGENTS.md, Server layout). A file takes the
  // first zone that matches it, so tests, which may import any domain, come
  // before the domains that hold them.
  "boundaries": {
    "zones": [
      { "name": "lint", "patterns": ["tools/oxlint/i18n/**"] },
      { "name": "brand", "patterns": ["tools/brand/**"] },
      { "name": "domain", "patterns": ["packages/domain/**"] },
      { "name": "machine", "patterns": ["packages/machine/**"] },
      { "name": "maps", "patterns": ["packages/maps/**"] },
      { "name": "server-tests", "patterns": ["packages/server/src/**/tests/**"] },
      {
        "name": "server-tools",
        "patterns": [
          "packages/server/scripts/**",
          "packages/server/eval/**",
          "packages/server/vitest.config.ts",
          "packages/server/vitest.eval.config.ts",
          "packages/server/vitest.scripts.config.ts"
        ]
      },
      {
        "name": "server-foundation",
        "patterns": ["packages/server/src/platform/**", "packages/server/src/utils/**"]
      },
      { "name": "server-visitors", "patterns": ["packages/server/src/visitors/**"] },
      { "name": "server-series", "patterns": ["packages/server/src/series/**"] },
      { "name": "server-sources", "patterns": ["packages/server/src/sources/**"] },
      { "name": "server-politics", "patterns": ["packages/server/src/politics/**"] },
      { "name": "server-catalog", "patterns": ["packages/server/src/catalog/**"] },
      { "name": "server-gather", "patterns": ["packages/server/src/gather/**"] },
      { "name": "server-views", "patterns": ["packages/server/src/views/**"] },
      { "name": "server-research", "patterns": ["packages/server/src/research/**"] },
      { "name": "server-assistant", "patterns": ["packages/server/src/assistant/**"] },
      { "name": "server-api", "patterns": ["packages/server/src/api/**"] },
      { "name": "server-workflows", "patterns": ["packages/server/src/workflows/**"] },
      {
        "name": "server",
        "patterns": ["packages/server/src/index.ts", "packages/server/src/cloudflare.d.ts"]
      },
      { "name": "web", "patterns": ["apps/web/**"] },
      { "name": "infra", "patterns": ["packages/infra/**"] }
    ],
    "rules": [
      { "from": "lint", "allow": [] },
      { "from": "brand", "allow": [] },
      { "from": "domain", "allow": [] },
      { "from": "machine", "allow": [] },
      { "from": "maps", "allow": ["domain"] },
      { "from": "server-foundation", "allow": ["domain", "machine"] },
      {
        "from": "server-visitors",
        "allow": ["domain", "machine", "server-foundation"]
      },
      {
        "from": "server-series",
        "allow": ["domain", "machine", "server-foundation", "server-visitors"]
      },
      {
        "from": "server-sources",
        "allow": ["domain", "machine", "server-foundation", "server-visitors", "server-series"]
      },
      {
        "from": "server-politics",
        "allow": [
          "domain",
          "machine",
          "server-foundation",
          "server-visitors",
          "server-series",
          "server-sources"
        ]
      },
      {
        "from": "server-catalog",
        "allow": [
          "domain",
          "machine",
          "server-foundation",
          "server-visitors",
          "server-series",
          "server-sources",
          "server-politics"
        ]
      },
      {
        "from": "server-gather",
        "allow": [
          "domain",
          "machine",
          "server-foundation",
          "server-visitors",
          "server-series",
          "server-sources",
          "server-politics",
          "server-catalog"
        ]
      },
      {
        "from": "server-views",
        "allow": [
          "domain",
          "machine",
          "server-foundation",
          "server-visitors",
          "server-series",
          "server-sources",
          "server-politics",
          "server-catalog",
          "server-gather"
        ]
      },
      {
        "from": "server-research",
        "allow": [
          "domain",
          "machine",
          "server-foundation",
          "server-visitors",
          "server-series",
          "server-sources",
          "server-politics",
          "server-catalog",
          "server-gather",
          "server-views"
        ]
      },
      {
        "from": "server-assistant",
        "allow": [
          "domain",
          "machine",
          "server-foundation",
          "server-visitors",
          "server-series",
          "server-sources",
          "server-politics",
          "server-catalog",
          "server-gather",
          "server-views",
          "server-research"
        ]
      },
      {
        "from": "server-api",
        "allow": [
          "domain",
          "machine",
          "server-foundation",
          "server-visitors",
          "server-series",
          "server-sources",
          "server-politics",
          "server-catalog",
          "server-gather",
          "server-views",
          "server-research",
          "server-assistant"
        ]
      },
      {
        "from": "server-workflows",
        "allow": [
          "domain",
          "machine",
          "server-foundation",
          "server-visitors",
          "server-series",
          "server-sources",
          "server-politics",
          "server-catalog",
          "server-gather",
          "server-views",
          "server-research",
          "server-assistant",
          "server-api"
        ]
      },
      {
        "from": "server",
        "allow": [
          "domain",
          "machine",
          "server-foundation",
          "server-visitors",
          "server-series",
          "server-sources",
          "server-politics",
          "server-catalog",
          "server-gather",
          "server-views",
          "server-research",
          "server-assistant",
          "server-api",
          "server-workflows"
        ]
      },
      {
        "from": "server-tests",
        "allow": [
          "domain",
          "machine",
          "server",
          "server-foundation",
          "server-tests",
          "server-tools",
          "server-visitors",
          "server-series",
          "server-sources",
          "server-politics",
          "server-catalog",
          "server-gather",
          "server-views",
          "server-research",
          "server-assistant",
          "server-api",
          "server-workflows"
        ]
      },
      {
        "from": "server-tools",
        "allow": [
          "domain",
          "machine",
          "server",
          "server-foundation",
          "server-tests",
          "server-visitors",
          "server-series",
          "server-sources",
          "server-politics",
          "server-catalog",
          "server-gather",
          "server-views",
          "server-research",
          "server-assistant",
          "server-api",
          "server-workflows"
        ]
      },
      { "from": "web", "allow": ["server", "server-workflows", "domain", "machine", "maps"] },
      { "from": "infra", "allow": [] }
    ],
    "coverage": { "requireAllFiles": true }
  }
}
