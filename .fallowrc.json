{
  "$schema": "./node_modules/fallow/schema.json",
  // Vendored code follows its upstream; see each folder's UPSTREAM.md.
  "ignorePatterns": ["tools/oxlint/anti-slop/**", ".claude/**", ".agents/**"],
  "ignoreDependencies": [
    // The tsconfig plugin name. @effect/tsgo provides it.
    "@effect/language-service",
    // Imported only by the vendored anti-slop rules, which are ignored above.
    "@oxlint/plugins",
    // Data files apps/web/scripts reads by path, not by import.
    "flag-icons",
    "i18n-iso-countries",
    "world-atlas"
  ],
  // The workspace packages are private, so an export nothing in the repo uses
  // is dead even when it sits in a package entry point.
  "includeEntryExports": true,
  "ignoreExports": [
    // TanStack Router generates this file and decides what it exports.
    { "file": "apps/web/src/routeTree.gen.ts", "exports": ["*"] },
    // shadcn components export every sub-part; pages use a few. An unused
    // component file is still reported.
    { "file": "apps/web/src/components/ui/**", "exports": ["*"] },
    // The Worker's entry: Cloudflare reads its default export and its Durable
    // Object classes.
    { "file": "apps/web/src/server.ts", "exports": ["*"] },
    // The Workflow classes the Worker entry exports. They reach the entry
    // through the `workerd` condition of @civicdata/server/workflow, which
    // Fallow does not resolve.
    {
      "file": "packages/server/src/workflows.ts",
      "exports": ["CatalogWorkflow", "GatherWorkflow"]
    }
  ],
  // Cloudflare calls a Durable Object's handlers.
  "usedClassMembers": [{ "implements": "DurableObject", "members": ["fetch", "alarm"] }],
  "effect": { "schemaExportsAsTypes": true },
  // shadcn's generated components are kept close to upstream rather than
  // restructured; complexity limits apply to our own code. Build scripts run by
  // hand; tests check what they write (faces.gen.ts), not the scripts.
  "health": { "ignore": ["apps/web/src/components/ui/**", "apps/web/scripts/**"] },
  "rules": {
    "unused-effect-layers": "error",
    "unused-tagged-errors": "error",
    "unproduced-catch-tags": "error"
  },
  // Dependencies point one way: web -> server -> domain. Infra deploys the app
  // and nothing imports it. A new package needs a zone before CI passes.
  "boundaries": {
    "zones": [
      { "name": "domain", "patterns": ["packages/domain/**"] },
      { "name": "server", "patterns": ["packages/server/**"] },
      { "name": "web", "patterns": ["apps/web/**"] },
      { "name": "infra", "patterns": ["packages/infra/**"] }
    ],
    "rules": [
      { "from": "domain", "allow": [] },
      { "from": "server", "allow": ["domain"] },
      { "from": "web", "allow": ["server", "domain"] },
      { "from": "infra", "allow": [] }
    ],
    "coverage": { "requireAllFiles": true }
  }
}
