{
  "name": "openfacts",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose up --detach --wait && OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 OTEL_EXPORTER_OTLP_HEADERS= pnpm --filter @repo/infra run dev",
    "dev:web": "turbo run dev --filter=@repo/web",
    "storybook": "turbo run storybook --filter=@repo/web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:lint": "node --test tools/oxlint/i18n/plugin.test.mjs",
    "lint": "oxlint --deny-warnings --ignore-pattern 'packages/maps/**' && turbo run lint --filter=@repo/maps",
    "format": "oxfmt",
    "format:check": "oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore && turbo run format:check --filter=@repo/maps",
    "fallow": "fallow",
    "check": "pnpm format:check && pnpm lint && pnpm test:lint && pnpm fallow && turbo run typecheck test build",
    "prepare": "effect-tsgo patch --typescript",
    "evals": "node packages/server/scripts/evals.ts",
    "brand": "node tools/brand/brand.mjs"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.5",
    "@oxlint/plugins": "1.92.0",
    "@resvg/resvg-js": "2.6.2",
    "fallow": "^3.41.0",
    "opentype.js": "^2.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.18.0"
}
